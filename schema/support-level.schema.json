{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teknoloji-Filozoflari/Nova-Commands/main/schema/support-level.schema.json",
  "title": "Nova-Commands support-levels registry",
  "description": "Registry of support-level labels for platform/content maturity. Additive metadata; does not claim command coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "support_levels"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "nova-commands-support-level-registry" },
    "support_levels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "localizedShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 32
        },
        "label": { "$ref": "#/$defs/localizedShort" },
        "summary": { "$ref": "#/$defs/localizedShort" },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Higher = more mature / broader coverage claim."
        }
      }
    }
  }
}
