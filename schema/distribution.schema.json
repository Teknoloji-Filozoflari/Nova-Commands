{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teknoloji-Filozoflari/Nova-Commands/main/schema/distribution.schema.json",
  "title": "Nova-Commands distributions registry",
  "description": "OS distributions / product editions. References operating-systems; must not be conflated with package managers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "distributions"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "nova-commands-distribution-registry" },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "localizedShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "localizedLong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "en": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "operating_system", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "name": { "$ref": "#/$defs/localizedShort" },
        "summary": { "$ref": "#/$defs/localizedLong" },
        "operating_system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Must reference metadata/operating-systems.yaml id."
        },
        "id_like": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "os-release ID_LIKE-style ancestry hints; do not assume identical tooling."
        },
        "parent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Optional parent distribution id (derivative)."
        },
        "variant": {
          "type": "string",
          "enum": [
            "general",
            "server",
            "desktop",
            "immutable",
            "iot",
            "appliance",
            "embedded",
            "cloud"
          ]
        },
        "package_managers": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": "Typical system PMs; refs into package-managers registry."
        },
        "init_systems": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "status": {
          "type": "string",
          "enum": ["skeleton", "draft", "reviewed", "verified"]
        },
        "support_level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "documentation": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 512
          }
        },
        "notes": { "$ref": "#/$defs/localizedLong" },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
