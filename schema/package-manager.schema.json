{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teknoloji-Filozoflari/Nova-Commands/main/schema/package-manager.schema.json",
  "title": "Nova-Commands package-managers registry",
  "description": "Independent package-manager catalog. Not nested under a single OS; platforms/distributions are references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "package_managers"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "nova-commands-package-manager-registry" },
    "package_managers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "localizedShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "localizedLong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "en": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "pm_kind", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "name": { "$ref": "#/$defs/localizedShort" },
        "summary": { "$ref": "#/$defs/localizedLong" },
        "pm_kind": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "language",
            "application-runtime",
            "ports-source",
            "distribution-format",
            "meta",
            "other"
          ],
          "description": "AppImage-like formats use distribution-format, not system PM."
        },
        "cli_names": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "package_format": {
          "type": "string",
          "maxLength": 64
        },
        "scope": {
          "type": "string",
          "enum": ["system", "user", "project", "mixed"]
        },
        "operating_systems": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "distributions": {
          "type": "array",
          "maxItems": 48,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "repository_model": {
          "type": "string",
          "enum": [
            "central-repos",
            "channels",
            "ports-tree",
            "flakes",
            "store-profiles",
            "language-index",
            "app-store",
            "sidecar-file",
            "mixed",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["skeleton", "draft", "reviewed", "verified"]
        },
        "support_level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "documentation": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 512
          }
        },
        "security_notes": { "$ref": "#/$defs/localizedLong" },
        "notes": { "$ref": "#/$defs/localizedLong" },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
