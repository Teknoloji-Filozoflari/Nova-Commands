{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teknoloji-Filozoflari/Nova-Commands/main/schema/task.schema.json",
  "title": "Nova-Commands task entry",
  "description": "Intent → multi-platform implementations under tasks/. Tasks must NOT reuse command ids. Separate from command.schema.v2.json. Indexed into catalog/search-index/manifest by scripts/build_catalog.py (Faz 9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "category",
    "intent",
    "implementations",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "kind": {
      "type": "string",
      "const": "task"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Task id (e.g. show-local-ip). Must not collide with command ids."
    },
    "name": {
      "$ref": "#/$defs/localizedShort"
    },
    "summary": {
      "$ref": "#/$defs/localizedLong"
    },
    "description": {
      "$ref": "#/$defs/localizedLong"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "tags": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        },
        "en": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        }
      }
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/taskImplementation" }
    },
    "related_commands": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+._-]*$"
      }
    },
    "related_tasks": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "verified"]
        },
        "sources": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "last_reviewed": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reviewer": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "notes": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "$defs": {
    "localizedShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "localizedLong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "en": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "registryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "taskImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commands", "examples"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "operating_systems": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryId" }
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["linux", "macos", "bsd", "windows", "android"]
          }
        },
        "shells": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryId" }
        },
        "distributions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryId" }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "description": "Command bank ids used by this implementation (must exist after Faz 3+ content).",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+._-]*$"
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/example" }
        },
        "notes": { "$ref": "#/$defs/localizedShort" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "risk"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedShort" },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "explanation": { "$ref": "#/$defs/localizedLong" },
        "shell": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "risk": {
          "type": "string",
          "enum": ["safe", "caution", "dangerous", "destructive"]
        },
        "privilege": {
          "type": "string",
          "enum": ["none", "user", "elevated", "admin"]
        },
        "requires_elevated": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "description": "Optional bilingual operator warnings (download/build/mutate side effects).",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/localizedShort"
          }
        }
      }
    }
  }
}
