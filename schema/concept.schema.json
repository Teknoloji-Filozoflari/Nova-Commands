{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teknoloji-Filozoflari/Nova-Commands/main/schema/concept.schema.json",
  "title": "Nova-Commands concept article",
  "description": "Learnable cross-cutting concept (TR/EN). Not a command entry; complements metadata/concepts.yaml labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "summary",
    "body",
    "difficulty",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "const": "nova-commands-concept"
    },
    "title": { "$ref": "#/$defs/localizedShort" },
    "summary": { "$ref": "#/$defs/localizedShort" },
    "body": { "$ref": "#/$defs/localizedBody" },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "related_commands": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+._-]*$"
      }
    },
    "related_concepts": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "see_also": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "verified"],
          "description": "verified ONLY after human review. Agent-authored content stays draft or reviewed."
        },
        "sources": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "last_reviewed": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  },
  "$defs": {
    "localizedShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "localizedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 80, "maxLength": 12000 },
        "en": { "type": "string", "minLength": 80, "maxLength": 12000 }
      }
    }
  }
}
