{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teknoloji-Filozoflari/Nova-Commands/main/schema/profile.schema.json",
  "title": "Nova-Commands profile entry",
  "description": "Server / homelab / role profiles under profiles/. Guiding reference collections — not auto-executed scripts. Catalog indexing of profiles is Faz 9; Faz 8 validates the tree.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "verification"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "kind": {
      "type": "string",
      "const": "profile"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "$ref": "#/$defs/localizedShort"
    },
    "summary": {
      "$ref": "#/$defs/localizedLong"
    },
    "description": {
      "$ref": "#/$defs/localizedLong"
    },
    "operating_systems": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/registryId" }
    },
    "distributions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/registryId" }
    },
    "server_platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/registryId" }
    },
    "related_commands": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+._-]*$"
      }
    },
    "related_tasks": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "verified"]
        },
        "sources": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "last_reviewed": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reviewer": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "notes": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "$defs": {
    "registryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "localizedShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "localizedLong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {
        "tr": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "en": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
